# ---------------------------------------------------------------------------
#  Collect the build identification used by build_release.bat
#
#  This mirrors what the top-level CMakeLists.txt already does for the
#  version number, so the release folder name can never disagree with the
#  binaries inside it:
#
#    AVS_VER    major.minor.bugfix, read from avs_core/core/version.h.in
#               (the same file the project itself uses for AVS_MAJOR_VER etc.)
#    BUILD_RNUM number of commits in the repository -- git rev-list --count
#               HEAD, i.e. the very same counter the built DLLs report as
#               AVS_SEQREV
#    BUILD_DATE the day the build runs
#    COMMIT_DATE the day of the last commit
#    GIT_*      branch / tag description / short hash, for the log
#
#  Usage:
#    cmake -D REPO=<repo root> -D SRC=<version.h.in> -D OUT=<out.cmd> -P build_info.cmake
#
#  The generated file holds plain "set" commands, so the batch script can
#  simply "call" it.
# ---------------------------------------------------------------------------

find_package(Git)

# --- version number (same regexes as the top-level CMakeLists.txt) ----------
file(READ "${SRC}" versioning)
string(REGEX MATCH "AVS_MAJOR_VER[ \t]+([0-9]*)" _ "${versioning}")
set(version_major "${CMAKE_MATCH_1}")
string(REGEX MATCH "AVS_MINOR_VER[ \t]+([0-9]*)" _ "${versioning}")
set(version_minor "${CMAKE_MATCH_1}")
string(REGEX MATCH "AVS_BUGFIX_VER[ \t]+([0-9]*)" _ "${versioning}")
set(version_bugfix "${CMAKE_MATCH_1}")
set(AVS_VER "${version_major}.${version_minor}.${version_bugfix}")

# --- git derived values ----------------------------------------------------
set(BUILD_RNUM "")
set(GIT_BRANCH "")
set(GIT_DESCRIBE "")
set(GIT_HASH "")
set(COMMIT_DATE "")

if(GIT_FOUND AND EXISTS "${REPO}/.git")
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" rev-list --count HEAD
    OUTPUT_VARIABLE BUILD_RNUM OUTPUT_STRIP_TRAILING_WHITESPACE)

  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" rev-parse --abbrev-ref HEAD
    OUTPUT_VARIABLE GIT_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE)

  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" rev-parse --short HEAD
    OUTPUT_VARIABLE GIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE)

  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" describe --tags
    OUTPUT_VARIABLE GIT_DESCRIBE OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)

  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${REPO}" log -1 HEAD --format=%cd --date=format:%Y%m%d
    OUTPUT_VARIABLE COMMIT_DATE OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()

# --- build date (today, local time) ----------------------------------------
#  NOTE: the argument order of string(TIMESTAMP) changed in CMake 4.x --
#  the output variable comes first now.  The old order is silently ignored
#  (the output variable stays empty), so keep this order.
string(TIMESTAMP BUILD_DATE "%Y%m%d")

# --- write the generated .cmd ----------------------------------------------
#  CRLF line endings, like the hand-written .bat files (the repository's
#  .gitattributes marks *.cmd as eol=crlf as well).
set(_avs_build_info
"rem Generated by build_info.cmake -- do not edit.
rem Re-generated on every run of build_release.bat.
set \"AVS_VER=${AVS_VER}\"
set \"BUILD_DATE=${BUILD_DATE}\"
set \"COMMIT_DATE=${COMMIT_DATE}\"
set \"BUILD_RNUM=${BUILD_RNUM}\"
set \"GIT_BRANCH=${GIT_BRANCH}\"
set \"GIT_DESCRIBE=${GIT_DESCRIBE}\"
set \"GIT_HASH=${GIT_HASH}\"
")
string(REPLACE "\n" "\r\n" _avs_build_info "${_avs_build_info}")
file(WRITE "${OUT}" "${_avs_build_info}")

message(STATUS "Version    : ${AVS_VER}")
message(STATUS "Revision   : ${BUILD_RNUM}")
message(STATUS "Build date : ${BUILD_DATE}")
message(STATUS "Commit date: ${COMMIT_DATE}")
message(STATUS "Branch     : ${GIT_BRANCH} (${GIT_DESCRIBE}, ${GIT_HASH})")
